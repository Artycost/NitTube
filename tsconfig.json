{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*", "./src/lib/*.ts", "./src/lib/*.svelte.ts"]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"prettier.config.js",
		"eslint.config.js",
		"playwright.config.ts",
		"drizzle.config.ts"
	]
}
